# Database (Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meatrecords

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Auth.js
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Email (Resend) — optional, used for magic links
AUTH_EMAIL_FROM=noreply@example.com
RESEND_API_KEY=

# Cloudflare R2 — optional, dev mode works without it
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# AI providers — optional for mock mode
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Moderator emails (comma-separated)
MODERATOR_EMAILS=admin@example.com
